# Configuración del servidor
PORT=3000

# Configuración de SQL Server
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_NAME=login_system
DB_PORT=1433
DB_INSTANCE=SQLEXPRESS
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Clave secreta para JWT (genera una clave única y segura)
JWT_SECRET=genera_una_clave_aleatoria_muy_segura

# Configuración del entorno
NODE_ENV=development

# Instrucciones para SQL Server:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores de ejemplo con tus datos reales
# 3. Para SQL Server Express usa: DB_INSTANCE=SQLEXPRESS
# 4. Para instancia por defecto deja DB_INSTANCE vacío
# 5. Asegúrate de que SQL Server esté configurado para autenticación mixta
# 6. Nunca subas el archivo .env a GitHub