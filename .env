# Configuración del servidor
PORT=3000

# Configuración de SQL Server
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=tu_password_sqlserver
DB_NAME=login_system
DB_PORT=1433
DB_INSTANCE=SQLEXPRESS
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Clave secreta para JWT (genera una aleatoria para producción)
JWT_SECRET=tu_clave_secreta_super_segura_aqui_12345

# Configuración adicional
NODE_ENV=development

# Configuraciones comunes para SQL Server en Windows:
# - Para SQL Server Express: DB_INSTANCE=SQLEXPRESS
# - Para instancia por defecto: no definir DB_INSTANCE
# - Para autenticación Windows: usar DB_USER y DB_PASSWORD vacíos (requiere configuración adicional)
# - Para Azure SQL: DB_ENCRYPT=true